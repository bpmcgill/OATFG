<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Cyberpunk Dark Pastel — dark canvas, neon palette shifted soft -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0E1220" Offset="0" />
        <GradientStop Color="#131A30" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#161E38" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1F2A4A" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0B101F" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3A4A7A" />
    <SolidColorBrush x:Key="TextBrush" Color="#E9EEFF" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#A3B4D8" />
    <SolidColorBrush x:Key="AccentBrush" Color="#9BE8FF" />
    <SolidColorBrush x:Key="AccentBrushBright" Color="#C4F2FF" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#0A2230" />
    <SolidColorBrush x:Key="AccentBrushDim" Color="#1D3A52" />

    <SolidColorBrush x:Key="NeonBlue" Color="#9BE8FF" />
    <SolidColorBrush x:Key="NeonPurple" Color="#D3B1FF" />
    <SolidColorBrush x:Key="NeonRed" Color="#FFA3C2" />
    <SolidColorBrush x:Key="NeonGreen" Color="#A8F3D5" />
    <SolidColorBrush x:Key="NeonPink" Color="#FFC2EF" />
    <SolidColorBrush x:Key="NeonOrange" Color="#FFCFA3" />

</ResourceDictionary>