<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Cyberpunk Dark — near-black canvas with full-strength neon accents -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0B0F1E" Offset="0" />
        <GradientStop Color="#10162B" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#121A2E" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1A2340" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0D1322" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2C3A63" />
    <SolidColorBrush x:Key="TextBrush" Color="#D9E4FF" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8FA3C8" />
    <SolidColorBrush x:Key="AccentBrush" Color="#00F0FF" />
    <SolidColorBrush x:Key="AccentBrushBright" Color="#67F8FF" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#062A33" />
    <SolidColorBrush x:Key="AccentBrushDim" Color="#123B4A" />

    <SolidColorBrush x:Key="NeonBlue" Color="#00F0FF" />
    <SolidColorBrush x:Key="NeonPurple" Color="#B026FF" />
    <SolidColorBrush x:Key="NeonRed" Color="#FF2E63" />
    <SolidColorBrush x:Key="NeonGreen" Color="#00FF9F" />
    <SolidColorBrush x:Key="NeonPink" Color="#FF2ED1" />
    <SolidColorBrush x:Key="NeonOrange" Color="#FF8A00" />

</ResourceDictionary>