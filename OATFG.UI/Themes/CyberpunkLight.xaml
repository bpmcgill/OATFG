<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Cyberpunk Light — light canvas, same neon hues deepened for contrast -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EEF2FB" Offset="0" />
        <GradientStop Color="#FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F0F4FF" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FBFCFE" />
    <SolidColorBrush x:Key="BorderBrush" Color="#C6D2ED" />
    <SolidColorBrush x:Key="TextBrush" Color="#0F1526" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#5A6B93" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0066CC" />
    <SolidColorBrush x:Key="AccentBrushBright" Color="#3399EE" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentBrushDim" Color="#D5E8FA" />

    <SolidColorBrush x:Key="NeonBlue" Color="#0077CC" />
    <SolidColorBrush x:Key="NeonPurple" Color="#7A2EFF" />
    <SolidColorBrush x:Key="NeonRed" Color="#D81B60" />
    <SolidColorBrush x:Key="NeonGreen" Color="#00A86B" />
    <SolidColorBrush x:Key="NeonPink" Color="#C2189B" />
    <SolidColorBrush x:Key="NeonOrange" Color="#C75E00" />

</ResourceDictionary>